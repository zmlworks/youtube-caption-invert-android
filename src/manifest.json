{
  "manifest_version": 3,
  "name": "YouTube inverted color subtitle for Android",
  "version": "2.6.0",
  "description": "Invert YouTube caption colors for readability. Tap a caption to switch modes.",
  "browser_specific_settings": {
    "gecko": {
      "id": "android.youtube.inverted.color.subtitle@kofu.com",
      "strict_min_version": "120.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*"
  ],
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "字幕の色を反転",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "96": "icon96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "invert.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
